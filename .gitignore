# ============================================================
#  .gitignore — Portfólio Flask (Python 3 / Linux)
# ============================================================


# ── Ambiente virtual ─────────────────────────────────────────
.venv/
venv/
env/
ENV/


# ── Variáveis de ambiente / segredos ────────────────────────
.env
.env.local
.env.*.local
*.env

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Distribuição / empacotamento
dist/
build/
*.egg-info/
*.egg
.eggs/

# ── Flask / Werkzeug ─────────────────────────────────────────
instance/
.webassets-cache
flask_session/

# ── Banco de dados local ─────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Logs ────────────────────────────────────────────────────
*.log
logs/

# ── Testes e cobertura ───────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Ferramentas de tipo ──────────────────────────────────────
.mypy_cache/
.pyright/
pyrightconfig.json

# ── IDEs ────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ── Sistema operacional ──────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Uploads de usuário (runtime) ─────────────────────────────
app/static/uploads/

# ── Arquivos de build de frontend ────────────────────────────
node_modules/
*.min.js.map